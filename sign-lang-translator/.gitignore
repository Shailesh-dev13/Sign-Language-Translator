# ====================================
# Signa AI — .gitignore
# ====================================

# ── Dependencies ──
node_modules/
package-lock.json

# ── Build output ──
dist/
dist-ssr/
*.local

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.whl
.eggs/
venv/
venv-*/
.venv/
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── ML model files (too large for git) ──
backend/models/asl_model.pth
backend/models/hand_landmarker.task
ml/trained_model/
ml/data/
*.keras
*.h5
*.tflite
*.onnx
temp_saved_model/

# ── Environment ──
.env
.env.local
.env.*.local

# ── IDE / Editor ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS ──
.DS_Store
*.swp
*~

# ── Misc ──
*.zip
*.tar.gz
