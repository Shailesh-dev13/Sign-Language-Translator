# ====================================
# Signa AI — .gitignore
# ====================================

# ── Dependencies ──
node_modules/
package-lock.json

# ── Build output ──
dist/
dist-ssr/
build/
*.local

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
*.whl
.eggs/
venv/
venv-*/
.venv/
env/
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/

# ── ML model files (too large for git) ──
ml/trained_model/
ml/data/
*.keras
*.h5
*.tflite
*.onnx
*.safetensors
temp_saved_model/

# ── Environment ──
.env
.env.local
.env.*.local
.env.production

# ── IDE / Editor ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS ──
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# ── Misc ──
*.zip
*.tar.gz
*.rar
.vercel
.netlify
